# Data — never commit
data/
*.parquet
*.csv
*.zip
!docs/**/*.csv
build/

# Secrets
.env
*.pem
credentials
.aws/
.streamlit/secrets.toml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Models
models/*.pkl
models/*.joblib

# Terraform — state can contain resource metadata, tfvars can contain account detail
# (.terraform.lock.hcl is intentionally NOT ignored — commit it so everyone
# resolves identical provider versions.)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log

# OS / editor
.DS_Store
.vscode/
.idea/
