# Copy to .env. The defaults below run the whole pipeline locally, with no
# AWS account and no credentials.

# --- Where each zone lives -------------------------------------------------
# A root is either a local directory or an s3:// prefix. Zones are independent,
# so S3 bronze with local gold is a valid combination.
DATA_ROOT=data
BRONZE_ROOT=data/bronze
SILVER_ROOT=data/silver
GOLD_ROOT=data/gold
DATAGUARD_PUBLIC_DASHBOARD=false

# Swap in these to run a zone against AWS instead.
# BRONZE_ROOT=s3://dataguard-ACCOUNT_ID-ap-southeast-2/bronze
# SILVER_ROOT=s3://dataguard-ACCOUNT_ID-ap-southeast-2/silver
# GOLD_ROOT=s3://dataguard-ACCOUNT_ID-ap-southeast-2/gold

# --- AWS, only used once a root points at s3:// ----------------------------
AWS_REGION=ap-southeast-2
GLUE_DATABASE=dataguard

# Optional: only notebooks/layer2/athena_eda.py uses Athena query output.
# ATHENA_OUTPUT=s3://your-athena-query-results/prefix/

# --- Source ----------------------------------------------------------------
# Only needed to query the OpenAQ v3 API for station metadata. Ingest reads the
# public archive bucket with unsigned requests and needs no key.
OPENAQ_API_KEY=
